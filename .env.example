# ============================================================================================
#  filesbull — Telegram file/PDF search bot · ENVIRONMENT VARIABLES  (.env.example)
#  Vercel → your project → Settings → Environment Variables → add each one → then Redeploy.
#  Local test: copy this file to .env and fill it. NEVER commit a real .env (it is in .gitignore).
#  Hindi: Vercel me har variable ka NAAM same rakho, sirf VALUE apni daalo. Token/keys kisi ko mat dikhana.
#  REQUIRED = bot iske bina nahi chalega.  Others are optional (feature turns on when you add it).
# ============================================================================================

# ---------- 1) REQUIRED ----------
# Telegram bot token. Telegram → @BotFather → /newbot → name + username → copy the token (123456789:AA...).
BOT_TOKEN=
# Supabase (free database). supabase.com → New project → Project Settings → API → "Project URL".
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API keys → "service_role" / secret key. SERVER ONLY — never put it in a web page.
SUPABASE_SERVICE_ROLE_KEY=
# Owner = you. Your numeric Telegram id: send /start to @userinfobot (or /myid / /start to your own bot).
# Several owners: 111111111,222222222   (sub-admins are added later inside the bot, not here)
ADMIN_USER_IDS=

# ---------- 2) AI (optional, recommended) — 5-provider router, any ONE key is enough ----------
# The bot works without AI (local search parser). With a key: Hinglish/spelling understanding, AI file naming, agent mode.
# You can also add keys later inside the bot: /admin → 🔑 AI Keys (stored in the database, never shown).
# Groq (free, fast): console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
# GROQ_MODEL=            # optional: pin a model (normally the bot picks a working one)
# Gemini (free tier): aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GOOGLE_API_KEY=        # same as GEMINI_API_KEY (other name)
# Mistral: console.mistral.ai → API Keys
MISTRAL_API_KEY=
# MISTRAL_API_KEY_2=
# OpenRouter (has free models): openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=
# NVIDIA: build.nvidia.com → Get API Key
NVIDIA_API_KEY=
# NVIDIA_API_KEY_2=
# OpenAI (paid): platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini

# AI limits (optional; defaults shown)
# AI_DAILY_PER_USER=12        # AI chat calls per user per day
# AI_DAILY_LIMIT=2000         # AI calls per day for the whole bot
# AI_UNDERSTAND=1             # 1 = AI reads each search message first, 0 = local parser only
# AI_UNDERSTAND_DAILY=40      # AI message readings per user per day
# AI_RANK=0                   # 1 = AI re-ranks results
# ADMIN_AI_DAILY=60           # AI admin commands per day
# AI_NAME_DAILY=600           # AI file namings per day
# AGENT_AI_DAILY=300          # AI agent-mode turns per day (owner chat)

# ---------- 3) USERBOT + BIG FILES (> 20 MB) — optional ----------
# my.telegram.org → log in with your phone → "API development tools" → create app → App api_id + App api_hash.
# Used by: 👤 userbot (reads source channels where the bot is not admin → Inbox), files > 20 MB (rename / big links).
TG_API_ID=
TG_API_HASH=
# GitHub token so the bot can START this repo's Actions at once (without it they still run on their schedule).
# github.com/settings/personal-access-tokens → Fine-grained → Only this repo → Permissions:
#   Actions: Read and write · Variables: Read and write (the bot then sets the repo variable BOT_URL itself).
# Also accepted under the names GH_DISPATCH_TOKEN, GITHUB_TOKEN, GH_PAT, GITHUB_PAT.
GH_TOKEN=
# GH_REPO=owner/repo     # auto: the repo Vercel deployed from (VERCEL_GIT_REPO_OWNER/VERCEL_GIT_REPO_SLUG)
# GH_BRANCH=main         # branch the Actions run on
# UB_MAX_PER_RUN=40      # max files the userbot forwards per run (~every 10 min)

# ---------- 4) WEB FILES (link se file + /upload page) — optional ----------
# UPLOAD_PASSWORD=       # /upload page password. Empty = the bot makes one; owner sends /upload to see it, /uploadpass = new
# UPLOAD_BUCKET=filesbull-uploads   # private Supabase Storage bucket for upload temp files (auto-created)
# WEB_INLINE_MAX_MB=49   # link files up to this size go in directly; bigger ones (≤ 1.9 GB) go via the GitHub Action

# ---------- 5) SECURITY KEYS — optional (derived from BOT_TOKEN when empty) ----------
# Set these to long random strings if you might change BOT_TOKEN later (otherwise a new token = userbot login again).
# Make one: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# WEBHOOK_SECRET=
# USERBOT_SECRET=
# BIGFILE_SECRET=
# UPLOAD_SECRET=

# ---------- 6) OTHER — optional ----------
# BOT_NAME=My Books Bot  # display name in texts (default: the bot's Telegram name)
# PUBLIC_URL=            # https address of the bot; only if NOT on Vercel or with a custom domain
# SUPABASE_ACCESS_TOKEN= # supabase.com/dashboard/account/tokens — lets the bot create its tables itself (else run setup.sql once)
# DIAG_TOKEN=            # developer diagnostics endpoints (/api/*diag). Leave empty = off.
# DIAG_TOKEN_SHA256=     # or: sha256 hex of the diag token instead of the token

# ---------- GitHub Actions (repo → Settings → Secrets and variables → Actions) ----------
# Variable  BOT_URL = https://<your-app>.vercel.app   (the bot sets it itself when GH_TOKEN has Variables: write)
# Secrets   none needed: the Actions prove who they are with GitHub's OIDC token and get what they need from your bot.
#           (Optional: BOT_TOKEN, TG_API_ID, TG_API_HASH as Actions secrets are used by the big-file job if present.)
